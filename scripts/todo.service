[Unit]
Description=Todo/Shopping list app
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/todo
ExecStart=%h/.local/share/todo/todo-server
EnvironmentFile=%h/.config/todo/environment
Environment=TODO_ADDR=127.0.0.1:8080
Restart=on-failure

[Install]
WantedBy=default.target
